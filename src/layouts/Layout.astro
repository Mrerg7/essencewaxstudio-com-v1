---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const POSTER =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/b687f8087e0bcbe2695074f2d88dec95/thumbnails/thumbnail.jpg?time=&height=600';

const {
  title = 'Essence Wax Studio | Refined Brazilian Wax',
  description = 'An elegant wax studio concept for Brazilian and sensitive-area hard wax. Smooth results for 3 to 4 weeks. Domain available.',
  ogImage = POSTER,
  canonical = 'https://essencewaxstudio.com/',
} = Astro.props;

const siteName = 'Essence Wax Studio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="J3dZuEKL7nnd-79cFj1ti6WePjUwCEENyjDNpjBZxUk" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2e1c19" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": "https://essencewaxstudio.com",
      "description": description
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonical,
      "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage },
      "datePublished": "2026-09-13",
      "dateModified": "2026-09-13"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does waxing last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wax epilation extracts hair from the root and typically provides smooth skin for 3 to 4 weeks. With consistent sessions, regrowth often becomes finer."
          }
        },
        {
          "@type": "Question",
          "name": "Why hard wax?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hard wax is ideal for the bikini line and underarms because it adheres to hair rather than skin, reducing pull and irritation."
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
