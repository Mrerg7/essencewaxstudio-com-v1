{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "jsx": "preserve",
    "jsxImportSource": "astro"
  },
  "include": ["src/**/*", "astro.config.mjs", ".astro/types.d.ts", ".astro/content.d.ts"],
  "exclude": ["dist", "node_modules"]
}
